# ═══════════════════════════════════════════════════════════════
# AgriSaarthi — ml-microservice environment variables
# Copy to `.env` inside ml-microservice/. Git-ignored — never commit real keys.
# ═══════════════════════════════════════════════════════════════

ML_SERVICE_PORT=8000
LOG_LEVEL=INFO
SVM_MODEL_PATH=app/models/artifacts/leaf_svm.joblib
PMFBY_ORG_NAME=AgriSaarthi Digital Advisory

# Comma-separated list of origins allowed to call this service directly.
ML_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Optional — enables live government-scheme search via Tavily.
# Get a free key at https://tavily.com. Without it, scheme search returns
# a static "check pmkisan.gov.in" fallback message.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
