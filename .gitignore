# ═══════════════════════════════════════════════════
# AgriSaarthi — .gitignore
# ═══════════════════════════════════════════════════

# ── Secrets (most important line in this file) ──
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials.json
service-account*.json

# ── Node (gateway + frontend) ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json.bak
.npm/
.yarn/
.eslintcache

# ── TypeScript build output ──
backend-gateway/dist/
*.tsbuildinfo

# ── Frontend (Vite + React + PWA) ──
frontend-new/dist/
frontend-new/.vite/

# vite-plugin-pwa generated files
frontend-new/public/sw.js
frontend-new/public/sw.js.map
frontend-new/public/workbox-*.js
frontend-new/public/workbox-*.js.map
frontend-new/public/registerSW.js

# ── C++ engine ──
mandi-engine/build/
mandi-engine/cmake-build-*/
*.o
*.a
*.so
*.dylib
*.exe
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# ── Python ML microservice ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.Python
pip-log.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Trained model artifacts (regenerate with: make train) ──
ml-microservice/app/models/artifacts/*
!ml-microservice/app/models/artifacts/leaf_svm.joblib
*.pkl
*.h5

# ── Training data / uploads ──
ml-microservice/data/
ml-microservice/uploads/
*.pdf
!docs/**/*.pdf

# ── OS cruft ──
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
*~

# ── Editors ──
.vscode/*
!.vscode/extensions.json
!.vscode/settings.sample.json
.idea/
*.swp
*.swo
*.sublime-workspace

# ── Logs & runtime ──
logs/
*.log
pids/
*.pid
*.seed
dump.rdb