# Base URL of the existing AgriSaarthi backend gateway (unchanged contract).
VITE_API_BASE=http://localhost:8080/api/v1

# Optional: map tile sources for the field-boundary / satellite map.
# Defaults to the public OpenStreetMap tile server if unset.
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_NDVI_TILE_URL=https://your-ndvi-tile-source/{z}/{x}/{y}.png

# Optional: default map center shown before the device location is known.
# VITE_DEFAULT_LAT=26.8467
# VITE_DEFAULT_LON=80.9462
