# ═══════════════════════════════════════════════════════════════
# AgriSaarthi — frontend environment variables
# Copy to `.env.local` inside frontend/. Git-ignored — never commit real keys.
# All NEXT_PUBLIC_* values are bundled into client-side JS and are NOT secret.
# ═══════════════════════════════════════════════════════════════

# URL of the backend-gateway API (include /api/v1)
NEXT_PUBLIC_API_BASE=http://localhost:8080/api/v1

# Default map center (Lucknow, UP) — used before the browser shares real geolocation.
NEXT_PUBLIC_DEFAULT_LAT=26.8467
NEXT_PUBLIC_DEFAULT_LON=80.9462

# Map tile source for the field map widget.
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional — satellite NDVI tile layer, if you have a provider configured.
NEXT_PUBLIC_NDVI_TILE_URL=
