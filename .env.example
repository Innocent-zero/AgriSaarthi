# ═══════════════════════════════════════════════════════════════
# AgriSaarthi — backend-gateway environment variables
# Copy this file to `.env` (same folder, project root) and fill in
# real values. `.env` is git-ignored — never commit real secrets.
# ═══════════════════════════════════════════════════════════════

# ── Required ──
# Any random string, 16+ characters. Used to sign farmer auth JWTs.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32-char-string

# ── Server ──
GATEWAY_PORT=8080
NODE_ENV=development
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240

# ── Redis (optional) ──
# Leave blank to use the built-in in-process cache fallback — fine for local dev.
REDIS_URL=

# ── Mandi (C++) engine ──
# Leave blank to auto-detect ./mandi-engine/build/mandi_router
MANDI_ENGINE_BIN=
MANDI_ENGINE_TIMEOUT_MS=5000

# ── ML microservice (leaf diagnosis, PMFBY PDF) ──
# Set once you're running ml-microservice locally, e.g. http://localhost:8000
ML_SERVICE_URL=

# ── Data sources (all optional — code falls back to keyless/demo data) ──
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
SOILGRIDS_URL=https://rest.isric.org/soilgrids/v2.0/properties/query
CACHE_TTL_WEATHER=1800
CACHE_TTL_SOIL=604800
CACHE_TTL_MANDI=3600

# data.gov.in AGMARKNET mandi price feed — get a free key at
# https://data.gov.in ; without it, seed/demo mandi prices are used.
DATA_GOV_IN_API_KEY=
DATA_GOV_MANDI_RESOURCE=9ef84268-d588-465a-a308-a864a43d0070

# ── Sponsor integrations (currently stubbed to local logic in code —
#    setting these alone will NOT activate them; see lyzrAgent.ts /
#    swytchcodeService.ts if you want to wire up real calls) ──
LYZR_API_KEY=
LYZR_AGENT_ID=
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
SWYTCHCODE_API_KEY=
SWYTCHCODE_BASE_URL=https://api.swytchcode.com/v1
SWYTCHCODE_ENABLED=false

# ── n8n alert webhooks (optional) ──
N8N_WEBHOOK_SECRET=
N8N_ALERT_DISPATCH_URL=
